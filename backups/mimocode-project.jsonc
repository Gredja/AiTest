{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "skills": {
    "paths": [".mimocode/skills"]
  },
  "mcp": {
    "slack-local": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "& { ./Scripts/sync-secrets.ps1 | Out-Null; cmd /c \"dotnet build Scripts/Tools -nologo -v:q -clp:ErrorsOnly 1>&2\"; if ($?) { dotnet run --project Scripts/Tools --no-build -- serve-slack } }"
      ]
    }
  }
}
