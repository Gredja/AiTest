<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
    <!-- %3B = escaped ';'. Per-project log name prevents Api/E2E filename collision.
         Raw run artifacts live in the temp workspace so TestResults/ holds only reports. -->
    <VSTestLogger>File%3BLogFileName=$(MSBuildProjectName).log</VSTestLogger>
    <VSTestResultsDirectory>$([System.IO.Path]::GetTempPath())GredjaTestRun</VSTestResultsDirectory>
    <!-- Auto-apply repo-root .runsettings (NumberOfTestWorkers, MaxCpuCount) on every dotnet test -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Static analysis layer (audit batch 9): build-time code-quality diagnostics -->
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
