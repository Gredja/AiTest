{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "skills": {
    "paths": [".mimocode/skills"]
  },
  "mcp": {
    "slack-local": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "& { ./Scripts/sync-secrets.ps1 | Out-Null; node Scripts/mcp-slack/server.mjs }"
      ]
    }
  }
}
