{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "skills": {
    "paths": [".mimocode/skills"]
  },
  "mcp": {
    "slack-local": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "Scripts/spawn-serve-slack.ps1"
      ]
    }
  }
}
