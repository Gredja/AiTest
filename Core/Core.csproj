<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Class library (references NUnit for test infrastructure) — not a VS Test Explorer container. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit's build props add TestContainer; without this VS tries (and fails) discovery here. -->
    <ProjectCapability Remove="TestContainer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Clean clone has no testsettings.json — fall back to the tracked example so build and JP tests work -->
    <None Include="..\testsettings.json" Link="testsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\testsettings.json')" />
    <None Include="..\testsettings.example.json" Link="testsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('..\testsettings.json')" />
  </ItemGroup>

</Project>
