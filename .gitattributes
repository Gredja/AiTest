# Auto detect text files and perform LF normalization
* text=auto

# C# sources
*.cs text eol=crlf
*.csx text eol=crlf

# Config / project files
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.json text eol=crlf
*.jsonc text eol=crlf

# Documentation
*.md text eol=lf

# Shell / scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Environment (never commit, but normalize if committed accidentally)
*.env text eol=lf

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
