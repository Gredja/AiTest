<Project>
  <PropertyGroup>
    <TestRunWorkspaceDir>$([System.IO.Path]::GetTempPath())GredjaTestRun</TestRunWorkspaceDir>
    <TestRunStartFile>$(TestRunWorkspaceDir)\.run-start</TestRunStartFile>
  </PropertyGroup>

  <!--
    Run-start marker + workspace cleanup: every raw log written after the marker belongs to
    this run; previous run's raw logs are deleted so TestResults/ stays reports-only and the
    workspace never grows.
    Solution runs: Core/TestAdapter VSTest fires first (slnx order) and starts the run.
    Standalone runs (dotnet test Api/Api.csproj): SolutionName is "*Undefined*" — the test
    project itself starts the run. Test projects inside a solution run never start a run,
    so the artifacts of the project that finished earlier survive.
    The report itself is generated by the TestReportSetup teardown (runs even on failures).
  -->
  <Target Name="MarkTestRunStart" BeforeTargets="VSTest">
    <PropertyGroup>
      <StandaloneRun Condition="'$(SolutionName)' == '' or '$(SolutionName)' == '*Undefined*'">true</StandaloneRun>
      <StartNewRun Condition="'$(IsTestProject)' != 'true'">true</StartNewRun>
      <StartNewRun Condition="'$(IsTestProject)' == 'true' and '$(StandaloneRun)' == 'true'">true</StartNewRun>
      <StartNewRun Condition="'$(IsTestProject)' == 'true' and '$(StandaloneRun)' != 'true' and !Exists('$(TestRunStartFile)')">true</StartNewRun>
    </PropertyGroup>
    <MakeDir Directories="$(TestRunWorkspaceDir)" />
    <ItemGroup Condition="'$(StartNewRun)' == 'true'">
      <StaleRawLog Include="$(TestRunWorkspaceDir)\actions-*.log" />
      <StaleRawLog Include="$(TestRunWorkspaceDir)\test-results-*.log" />
    </ItemGroup>
    <Touch Files="$(TestRunStartFile)" AlwaysCreate="true" Condition="'$(StartNewRun)' == 'true'" />
    <Delete Files="@(StaleRawLog)" Condition="'$(StartNewRun)' == 'true'" />
  </Target>
</Project>
